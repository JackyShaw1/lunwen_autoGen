# CaseAutoGenSystem 后端环境变量示例
# 复制为 .env 后修改

SECRET_KEY=change-me-in-production
DEBUG=true

# SQLite（默认）或 PostgreSQL
DATABASE_URL=sqlite:///./data/case_autogen.db

# 生成模式：true=Mock 流水线（无需 API Key）
USE_MOCK_GENERATION=true

# 可选：真实 LLM（需 USE_MOCK_GENERATION=false）
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
